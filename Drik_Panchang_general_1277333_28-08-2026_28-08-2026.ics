# @title Drik Panchang to Google Calendar (.ics) Generator (Dual ICS Output)
# @markdown Configure parameters below and click **Run**.

# 1. Install dependencies
!pip install -q requests beautifulsoup4 icalendar python-dateutil pytz

import datetime
from dateutil.rrule import DAILY, rrule
import re
import time
import urllib.parse
from bs4 import BeautifulSoup
from google.colab import files
from icalendar import Calendar, Event
import pytz
import requests

# --- FORM PARAMETERS ---
FROM_DATE = "2026-08-01"  # @param {type:"date"}
TO_DATE = "2026-08-31"  # @param {type:"date"}
GEONAME_ID = "1277333"  # @param {type:"string"} # Bengaluru: 1277333, Mumbai: 1275339, Delhi: 1273294, Chennai: 1264527, Hyderabad: 1269843
LOCATION_NAME = "Bengaluru"  # @param {type:"string"}
HOUR_FORMAT = "12-hour"  # @param ["12-hour", "24-hour"]
TIMEZONE_STR = "Asia/Kolkata"  # @param {type:"string"}

# Define the sources
SOURCES = [
    {
        "id": "english",
        "name": f"Drik Panchang English ({LOCATION_NAME})",
        "url": "https://www.drikpanchang.com/panchang/day-panchang.html",
        "filename": (
            f"drik_panchang_english_{LOCATION_NAME}_{FROM_DATE}_{TO_DATE}.ics"
        ),
    },
    {
        "id": "kannada",
        "name": f"Drik Panchanga Kannada ({LOCATION_NAME})",
        "url": (
            "https://www.drikpanchang.com/kannada/panchangam/kannada-day-panchangam.html"
        ),
        "filename": (
            f"drik_panchang_kannada_{LOCATION_NAME}_{FROM_DATE}_{TO_DATE}.ics"
        ),
    },
]


def clean_text(text):
  if not text:
    return ""
  # Remove tooltips/info icons (ⓘ, (i), etc.) and clean spaces
  text = re.sub(r"[ⓘℹ️]|(?:\(i\))", "", text)
  text = re.sub(r"\s+", " ", text).replace("\xa0", " ").strip(" :")
  return text


def format_time_values(text, target_format):
  if not text:
    return ""

  def repl(match):
    h, m, meridiem = (
        int(match.group(1)),
        match.group(2),
        match.group(3).upper() if match.group(3) else "",
    )
    if meridiem == "PM" and h < 12:
      h_24 = h + 12
    elif meridiem == "AM" and h == 12:
      h_24 = 0
    else:
      h_24 = h

    if target_format == "24-hour":
      return f"{h_24:02d}:{m}"
    else:
      mer = "AM" if h_24 < 12 else "PM"
      h_12 = h_24 % 12
      h_12 = 12 if hour_12 == 0 else hour_12
      return f"{h_12:02d}:{m} {mer}"

  pattern = r"(\d{1,2}):(\d{2})(?:\s*(AM|PM|am|pm))?"
  return re.sub(pattern, repl, text)


def fetch_day_panchang(date_obj, base_url, geoname_id, hour_format):
  headers = {
      "User-Agent": (
          "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML,"
          " like Gecko) Chrome/124.0.0.0 Safari/537.36"
      ),
      "Accept-Language": "en-US,en;q=0.9,kn;q=0.8",
  }

  dp_time_param = "12hour" if hour_format == "12-hour" else "24hour"
  params = {
      "date": date_obj.strftime("%d/%m/%Y"),
      "geoname-id": geoname_id,
      "time-format": dp_time_param,
  }

  try:
    resp = requests.get(base_url, params=params, headers=headers, timeout=12)
    if resp.status_code != 200:
      return None
  except Exception:
    return None

  soup = BeautifulSoup(resp.content, "html.parser")

  # Remove unwanted info/tooltip tags
  for tag in soup.find_all(
      ["span", "div", "a"],
      class_=re.compile(r"dpInfo|tooltip|info-icon|badge", re.I),
  ):
    tag.decompose()

  # 1. Day-Specific Festivals & Vrats
  festivals = []
  fest_section = soup.select(
      ".dpFestivalCard, .dpFestivalList, .dpDayFestival, div[class*='Festival']"
  )
  for sec in fest_section:
    for item in sec.find_all(
        ["div", "span", "a", "li"], class_=re.compile(r"dpEvent|dpFestival|dpName")
    ):
      txt = clean_text(item.get_text())
      if (
          txt
          and txt not in festivals
          and "Festivals" not in txt
          and len(txt) > 2
      ):
        festivals.append(txt)

  if not festivals:
    for node in soup.find_all("div", class_="dpEventName"):
      txt = clean_text(node.get_text())
      if txt and txt not in festivals:
        festivals.append(txt)

  # 2. Daily Panchang Attributes
  panchang_items = []
  seen_keys = set()

  rows = soup.find_all(
      ["tr", "div"], class_=re.compile(r"dpTableRow|dpTableContent|dpCard")
  )
  if not rows:
    rows = soup.find_all("tr")

  for r in rows:
    cells = r.find_all(["td", "div"], recursive=False)
    if len(cells) >= 2:
      k = clean_text(cells[0].get_text())
      v = clean_text(cells[1].get_text())
      if k and v and k not in seen_keys and ":" not in k and len(k) < 35:
        v_formatted = format_time_values(v, hour_format)
        panchang_items.append((k, v_formatted))
        seen_keys.add(k)
    else:
      txt = clean_text(r.get_text())
      if ":" in txt:
        parts = txt.split(":", 1)
        k = clean_text(parts[0])
        v = clean_text(parts[1])
        if k and v and k not in seen_keys and len(k) < 35:
          v_formatted = format_time_values(v, hour_format)
          panchang_items.append((k, v_formatted))
          seen_keys.add(k)

  return {
      "date": date_obj,
      "festivals": festivals,
      "panchang_items": panchang_items,
  }


# --- EXECUTION ---
start_dt = datetime.datetime.strptime(FROM_DATE, "%Y-%m-%d").date()
end_dt = datetime.datetime.strptime(TO_DATE, "%Y-%m-%d").date()
tz = pytz.timezone(TIMEZONE_STR)

for source in SOURCES:
  print(f"\n--- Generating: {source['name']} ---")
  cal = Calendar()
  cal.add("prodid", f"-//Drik Panchang//{source['id'].upper()}//EN")
  cal.add("version", "2.0")
  cal.add("X-WR-CALNAME", source["name"])
  cal.add("X-WR-TIMEZONE", TIMEZONE_STR)

  for dt in rrule(DAILY, dtstart=start_dt, until=end_dt):
    current_date = dt.date()
    data = fetch_day_panchang(
        current_date, source["url"], GEONAME_ID, HOUR_FORMAT
    )

    if not data or not data["panchang_items"]:
      time.sleep(0.3)
      continue

    # Determine Title
    tithi_val = ""
    for k, v in data["panchang_items"]:
      if "tithi" in k.lower() or "ತಿಥಿ" in k:
        tithi_val = v.split("upto")[0].strip() if "upto" in v else v
        break

    if data["festivals"]:
      extra = (
          f" (+{len(data['festivals'])-1} more)"
          if len(data["festivals"]) > 1
          else ""
      )
      summary = (
          f"{data['festivals'][0]}{extra} - {tithi_val}"
          if tithi_val
          else f"{data['festivals'][0]}{extra}"
      )
    else:
      summary = f"Panchang: {tithi_val}" if tithi_val else "Daily Panchang"

    # Description (strictly vertical line-by-line without emojis)
    desc_lines = []
    if data["festivals"]:
      desc_lines.append("Festivals and Vrat:")
      for f in data["festivals"]:
        desc_lines.append(f"- {f}")
      desc_lines.append("")

    desc_lines.append("Daily Panchang:")
    for k, v in data["panchang_items"]:
      desc_lines.append(f"{k}: {v}")

    desc_lines.append("")
    desc_lines.append(f"Location: {LOCATION_NAME}")
    desc_lines.append(f"Date: {current_date.strftime('%A, %d %B %Y')}")
    desc_lines.append("Source: DrikPanchang.com")

    event = Event()
    event.add("summary", summary)
    event.add("description", "\n".join(desc_lines))
    event.add("dtstart", current_date)
    event.add("dtend", current_date + datetime.timedelta(days=1))
    event.add("dtstamp", datetime.datetime.now(tz))
    event.add(
        "uid",
        f"{source['id']}-{current_date.strftime('%Y%m%d')}@{GEONAME_ID}.drikpanchang",
    )
    cal.add_component(event)

    time.sleep(0.3)

  # Write and download ICS
  with open(source["filename"], "wb") as f:
    f.write(cal.to_ical())

  print(f"Downloading {source['filename']}...")
  files.download(source["filename"])
